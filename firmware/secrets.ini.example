; Copy this file to secrets.ini and fill in your values.
; secrets.ini is gitignored and never committed.

[common]
; Shared by every build environment.
secrets_flags =
    -D API_KEY=\"your_supabase_key\"
    -D OTA_PASSWORD=\"your_ota_password\"

[legacy]
; Only included by the hardcoded legacy environments (esp32_com3, esp32_com4
; and their OTA variants).  NOT used by esp32_provisioning — that build
; receives WiFi credentials via BLE at runtime.
wifi_flags =
    -D WIFI_SSID=\"your_ssid\"
    -D WIFI_PASSWORD=\"your_password\"
